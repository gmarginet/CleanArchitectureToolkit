{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "CatGateway": {
    "Authentication": {
      "Audience": "cat-gateway",
      "RequireHttpsMetadata": false
    },
    "Services": {
      "catalog": {
        "Address": "http://localhost:5101",
        "StripPrefix": false,
        "HealthCheckPath": "/health",
        "Anonymous": [ "GET /books/**", "GET /categories/**" ]
      },
      "orders": {
        "Address": "http://localhost:5102",
        "StripPrefix": false,
        "HealthCheckPath": "/health"
      }
    }
  }
}
