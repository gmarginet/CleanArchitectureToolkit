    <ItemGroup>
        <Using Include="NUnit.Framework"/>
    </ItemGroup>

    <ItemGroup>
      <ProjectReference Include="..\..\..\modules\Cat.UnitTesting\Cat.UnitTesting.Messaging\Cat.UnitTesting.Messaging.csproj" />
