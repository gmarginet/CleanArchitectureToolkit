<Project Sdk="Aspire.AppHost.Sdk/13.6.4">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <UserSecretsId>cat-demo-apphost</UserSecretsId>
        <!-- ASPIRE010: the AppHost runs without the Aspire CLI bundle (AspireUseCliBundle is false, the SDK default). The dashboard and DCP come from NuGet, so dotnet run needs no extra tool. The bundle would need the Aspire CLI on every machine. -->
        <NoWarn>$(NoWarn);ASPIRE010</NoWarn>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Aspire.Hosting.AppHost" />
        <PackageReference Include="Aspire.Hosting.Azure.ServiceBus" />
        <PackageReference Include="Aspire.Hosting.JavaScript" />
        <PackageReference Include="Aspire.Hosting.SqlServer" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\..\Cat.Demo.Api.Gateway\Cat.Demo.Api.Gateway\Cat.Demo.Api.Gateway.csproj" />
        <ProjectReference Include="..\..\Cat.Demo.CatalogService\Cat.Demo.CatalogService.Api\Cat.Demo.CatalogService.Api.csproj" />
        <ProjectReference Include="..\..\Cat.Demo.InventoryService\Cat.Demo.InventoryService.Api\Cat.Demo.InventoryService.Api.csproj" />
        <ProjectReference Include="..\..\Cat.Demo.OrderService\Cat.Demo.OrderService.Api\Cat.Demo.OrderService.Api.csproj" />
        <ProjectReference Include="..\..\Cat.Demo.PaymentService\Cat.Demo.PaymentService.Api\Cat.Demo.PaymentService.Api.csproj" />
    </ItemGroup>

</Project>
