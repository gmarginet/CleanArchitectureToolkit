{
  "name": "cat-demo-webclient-app",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "api:generate": "openapi-typescript api/catalog.openapi.json -o src/api/catalog.schema.d.ts && openapi-typescript api/orders.openapi.json -o src/api/orders.schema.d.ts",
    "api:refresh": "node scripts/refresh-openapi.mjs",
    "predev": "npm run api:generate",
    "dev": "vite",
    "prebuild": "npm run api:generate",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "pretest": "npm run api:generate",
    "test": "vitest run",
    "preview": "vite preview"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.106.1",
    "bootstrap": "^5.3.9",
    "oidc-client-ts": "^3.5.0",
    "openapi-fetch": "^0.17.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-oidc-context": "^3.3.1",
    "react-router": "^8.5.1"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "jsdom": "^31.0.0",
    "openapi-typescript": "^7.13.0",
    "oxlint": "^1.90.0",
    "typescript": "^5.9.3",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  }
}
