{
  "$schema": "http://json.schemastore.org/template",
  "author": "Gert Marginet",
  "classifications": [ "Clean Architecture" ],
  "identity": "gmarginet.Cat.Templates.Command",
  "name": "CAT command",
  "shortName": "cat-command",
  "description": "A command with its handler in the Infrastructure project. Run it in the folder of the solution of a service.",
  "tags": { "language": "C#", "type": "item" },
  "sourceName": "ItemName",
  "preferNameDirectory": false,
  "forms": {
    "shortName": { "identifier": "replace", "pattern": "^.*\\.", "replacement": "" }
  },
  "symbols": {
    "ServiceName": {
      "type": "parameter",
      "datatype": "text",
      "description": "The full name of the service, such as Contoso.Shop.Orders.",
      "isRequired": true,
      "replaces": "ServiceName",
      "fileRename": "ServiceName"
    },
    "ServiceShort": {
      "type": "derived",
      "valueSource": "ServiceName",
      "valueTransform": "shortName",
      "replaces": "ServiceShort"
    }
  }
}
