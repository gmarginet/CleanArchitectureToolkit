{
  "$schema": "http://json.schemastore.org/template",
  "author": "Gert Marginet",
  "classifications": [ "Web", "API", "Clean Architecture" ],
  "identity": "gmarginet.Cat.Templates.Service",
  "name": "CAT service",
  "shortName": "cat-service",
  "description": "A service with the project structure of the Clean Architecture Toolkit.",
  "tags": { "language": "C#", "type": "solution" },
  "sourceName": "ServiceName",
  "preferNameDirectory": true,
  "defaultName": "MyService",
  "sources": [
    {
      "modifiers": [
        { "condition": "(!Tests)", "exclude": [ "ServiceName.CoreService.Tests/**" ] },
        { "condition": "(!ApiClient)", "exclude": [ "ServiceName.Api.Client/**" ] },
        { "condition": "(!ExampleRequest)", "exclude": [ "**/ExampleGet*.cs", "**/ExampleModel.cs", "ServiceName.Api/ServiceName.http" ] },
        { "condition": "(!NewSolution)", "exclude": [ "ServiceName.slnx" ] },
        { "condition": "(!Jobs)", "exclude": [ "**/ExampleJob*.cs", "ServiceName.Api/Extensions/SchedulerExtensions.cs", "ServiceName.Database/**/CatJobRun.sql" ] },
        { "condition": "(!Messages)", "exclude": [ "**/ExampleReceived*.cs", "ServiceName.CoreService/Messages/**", "ServiceName.Api/Extensions/MessageHandlerExtensions.cs", "ServiceName.Database/**/CatInbox.sql" ] },
        { "condition": "(!DatabaseFirst)", "exclude": [ "ServiceName.Database/**" ] },
        { "condition": "(DatabaseFirst && !SqlServer)", "exclude": [ "ServiceName.Database/*.sqlproj", "ServiceName.Database/Tables/**" ] },
        { "condition": "(DatabaseFirst && !PostgreSQL)", "exclude": [ "ServiceName.Database/Scripts/**" ] }
      ]
    }
  ],
  "forms": {
    "shortName": { "identifier": "replace", "pattern": "^.*\\.", "replacement": "" },
    "lower": { "identifier": "lowerCase" },
    "lowerShortName": { "identifier": "chain", "steps": [ "shortName", "lower" ] }
  },
  "symbols": {
    "Framework": {
      "type": "parameter",
      "datatype": "choice",
      "description": "The target framework of the service.",
      "choices": [
        { "choice": "net11.0", "description": ".NET 11, the latest release" },
        { "choice": "net10.0", "description": ".NET 10, the LTS release" }
      ],
      "defaultValue": "net11.0",
      "replaces": "TARGET_FRAMEWORK"
    },
    "Database": {
      "type": "parameter",
      "datatype": "choice",
      "description": "The database of the service.",
      "choices": [
        { "choice": "SqlServer", "description": "SQL Server" },
        { "choice": "PostgreSQL", "description": "PostgreSQL" }
      ],
      "defaultValue": "SqlServer"
    },
    "Approach": {
      "type": "parameter",
      "datatype": "choice",
      "description": "Where the schema of the database comes from.",
      "choices": [
        { "choice": "CodeFirst", "description": "The entities are code, and EF Core migrations make the schema" },
        { "choice": "DatabaseFirst", "description": "The schema is SQL, and the entities are scaffolded from it" }
      ],
      "defaultValue": "CodeFirst"
    },
    "NewSolution": {
      "type": "parameter",
      "datatype": "bool",
      "description": "Create a new solution file. Use false to add the projects to an existing solution at or above the output folder.",
      "defaultValue": "true"
    },
    "Tests": {
      "type": "parameter",
      "datatype": "bool",
      "description": "Add the project ServiceName.CoreService.Tests.",
      "defaultValue": "true"
    },
    "ApiClient": {
      "type": "parameter",
      "datatype": "bool",
      "description": "Add the project ServiceName.Api.Client for a service that other services call.",
      "defaultValue": "false"
    },
    "ExampleRequest": {
      "type": "parameter",
      "datatype": "bool",
      "description": "Add one example request, with its handler, query, test and endpoint.",
      "defaultValue": "true"
    },
    "Jobs": {
      "type": "parameter",
      "datatype": "bool",
      "description": "Add the scheduler of Cat.Scheduling with one example job.",
      "defaultValue": "false"
    },
    "Messages": {
      "type": "parameter",
      "datatype": "bool",
      "description": "Add message handlers: Cat.EventProcessor with Azure Service Bus and the inbox, with one example message.",
      "defaultValue": "false"
    },
    "CatVersion": {
      "type": "parameter",
      "datatype": "text",
      "description": "The version of the CAT packages. The default is the version of the template pack.",
      "defaultValue": "0.0.0-local",
      "replaces": "CAT_VERSION"
    },
    "ServiceShort": {
      "type": "derived",
      "valueSource": "name",
      "valueTransform": "shortName",
      "replaces": "ServiceShort",
      "fileRename": "ServiceShort"
    },
    "ServiceLower": {
      "type": "derived",
      "valueSource": "name",
      "valueTransform": "lowerShortName",
      "replaces": "servicelower"
    },
    "SqlServer": {
      "type": "computed",
      "value": "(Database == \"SqlServer\")"
    },
    "PostgreSQL": {
      "type": "computed",
      "value": "(Database == \"PostgreSQL\")"
    },
    "DatabaseFirst": {
      "type": "computed",
      "value": "(Approach == \"DatabaseFirst\")"
    },
    "Net10": {
      "type": "computed",
      "value": "(Framework == \"net10.0\")"
    }
  },
  "primaryOutputs": [
    { "path": "ServiceName.Api/ServiceName.Api.csproj" },
    { "path": "ServiceName.Contracts/ServiceName.Contracts.csproj" },
    { "path": "ServiceName.CoreService/ServiceName.CoreService.csproj" },
    { "path": "ServiceName.DataModels/ServiceName.DataModels.csproj" },
    { "path": "ServiceName.Infrastructure/ServiceName.Infrastructure.csproj" },
    { "condition": "(Tests)", "path": "ServiceName.CoreService.Tests/ServiceName.CoreService.Tests.csproj" },
    { "condition": "(ApiClient)", "path": "ServiceName.Api.Client/ServiceName.Api.Client.csproj" },
    { "condition": "(DatabaseFirst && SqlServer)", "path": "ServiceName.Database/ServiceName.Database.sqlproj" }
  ],
  "postActions": [
    {
      "condition": "(!NewSolution)",
      "description": "Add the projects of the service to the solution that holds the output folder.",
      "manualInstructions": [ { "text": "Run dotnet sln add for each project of the service." } ],
      "actionId": "D396686C-DE0E-4DE6-906D-291CD29FC5DE",
      "args": { "inRoot": "true" },
      "continueOnError": false
    }
  ]
}
