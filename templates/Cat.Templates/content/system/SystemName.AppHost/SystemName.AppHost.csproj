<Project Sdk="Aspire.AppHost.Sdk/13.6.5">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>TARGET_FRAMEWORK</TargetFramework>
        <UserSecretsId>SystemName-apphost</UserSecretsId>
        <!-- ASPIRE010: the AppHost runs without the Aspire CLI bundle. The dashboard and DCP come from NuGet, so dotnet run needs no extra tool. -->
        <NoWarn>$(NoWarn);ASPIRE010</NoWarn>
        <!--#if (DatabaseFirst && SqlServer)-->
        <!-- ASPIRE004: the SQL project is not an executable. The AppHost still needs the reference, because AddSqlProject reads the generated Projects class. -->
        <NoWarn>$(NoWarn);ASPIRE004</NoWarn>
        <!--#endif-->
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Aspire.Hosting.AppHost" />
        <!--#if (Messages)-->
        <PackageReference Include="Aspire.Hosting.Azure.ServiceBus" />
        <!--#endif-->
        <!--#if (SqlServer)-->
        <PackageReference Include="Aspire.Hosting.SqlServer" />
        <!--#if (DatabaseFirst)-->
        <PackageReference Include="CommunityToolkit.Aspire.Hosting.SqlDatabaseProjects" />
        <!--#endif-->
        <!--#else-->
        <PackageReference Include="Aspire.Hosting.PostgreSQL" />
        <!--#endif-->
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\SystemName.Api.Gateway\SystemName.Api.Gateway.csproj" />
        <ProjectReference Include="..\SystemName.ServiceShort.Api\SystemName.ServiceShort.Api.csproj" />
        <!--#if (DatabaseFirst && SqlServer)-->
        <ProjectReference Include="..\SystemName.ServiceShort.Database\SystemName.ServiceShort.Database.sqlproj" />
        <!--#endif-->
    </ItemGroup>

</Project>
