<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net11.0</TargetFramework>
        <LangVersion>latest</LangVersion>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <IsPackable>false</IsPackable>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="coverlet.collector">
          <PrivateAssets>all</PrivateAssets>
          <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
        <PackageReference Include="Microsoft.NET.Test.Sdk"/>
        <PackageReference Include="NUnit"/>
        <PackageReference Include="NUnit.Analyzers">
          <PrivateAssets>all</PrivateAssets>
          <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
        <PackageReference Include="NUnit3TestAdapter"/>
    </ItemGroup>

    <ItemGroup>
        <Using Include="NUnit.Framework"/>
    </ItemGroup>

    <ItemGroup>
      <ProjectReference Include="..\..\modules\Cat.UnitTesting\Cat.UnitTesting.Commands\Cat.UnitTesting.Commands.csproj" />
      <ProjectReference Include="..\..\modules\Cat.UnitTesting\Cat.UnitTesting.EventAggregators\Cat.UnitTesting.EventAggregators.csproj" />
      <ProjectReference Include="..\..\modules\Cat.UnitTesting\Cat.UnitTesting.Messaging\Cat.UnitTesting.Messaging.csproj" />
      <ProjectReference Include="..\..\modules\Cat.UnitTesting\Cat.UnitTesting.NUnit\Cat.UnitTesting.NUnit.csproj" />
      <ProjectReference Include="..\..\modules\Cat.UnitTesting\Cat.UnitTesting.Queries\Cat.UnitTesting.Queries.csproj" />
      <ProjectReference Include="..\..\modules\Cat.UnitTesting\Cat.UnitTesting.Responses.NUnit\Cat.UnitTesting.Responses.NUnit.csproj" />
      <ProjectReference Include="..\..\modules\Cat.UnitTesting\Cat.UnitTesting.ServiceRequests\Cat.UnitTesting.ServiceRequests.csproj" />
      <ProjectReference Include="..\..\modules\Cat.UnitTesting\Cat.UnitTesting.Users\Cat.UnitTesting.Users.csproj" />
    </ItemGroup>

</Project>
