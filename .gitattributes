# Store text files with LF in the repository and check them out with LF.
* text=auto eol=lf

# Scripts that must keep their platform line endings.
*.sh text eol=lf
*.ps1 text eol=crlf
*.cmd text eol=crlf
*.bat text eol=crlf

# Binary files.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.snk binary
*.nupkg binary
