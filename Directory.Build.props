<Project>
    <PropertyGroup>
        <LangVersion>14.0</LangVersion>
        <Nullable>enable</Nullable>
        <PackageId>gmarginet.$(MSBuildProjectName)</PackageId>
        <Authors>Gert Marginet</Authors>
        <PackageIcon>CatIcon.png</PackageIcon>
        <Copyright>MIT</Copyright>
        <PackageProjectUrl>https://gmarginet.github.io/CleanArchitectureToolkit/</PackageProjectUrl>
        <RepositoryUrl>https://github.com/gmarginet/CleanArchitectureToolkit</RepositoryUrl>
        <RepositoryType>GitHub</RepositoryType>
        <PackageReadmeFile>README_NUGET.md</PackageReadmeFile>
    </PropertyGroup>

    <PropertyGroup Condition=" '$(Configuration)' == 'Debug' ">
        <DocumentationFile>bin\Debug\$(MSBuildProjectName).xml</DocumentationFile>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <DefaultDocumentationFileNameFactory>NameAndMd5Mix</DefaultDocumentationFileNameFactory>
        <DefaultDocumentationIncludeUndocumentedItems>true</DefaultDocumentationIncludeUndocumentedItems>
        <DefaultDocumentationFolder>..\namespaces\$(MSBuildProjectName)</DefaultDocumentationFolder>
        <DefaultDocumentationLinksOutputFile>..\..\defaultDocumentation\defaultDocumentationLinks\$(MSBuildProjectName).ddlinks</DefaultDocumentationLinksOutputFile>
        <DefaultDocumentationLinksBaseUrl>../../../$([System.IO.Path]::GetFileName($([System.IO.Path]::GetDirectoryName($(MSBuildProjectDirectory)))))/namespaces/$(MSBuildProjectName)/</DefaultDocumentationLinksBaseUrl>
        <DefaultDocumentationConfigurationFile>..\..\defaultDocumentation\DefaultDocumentation.json</DefaultDocumentationConfigurationFile>
        <DefaultDocumentationPlugins>$(SolutionDir)resources\defaultDocumentationPlugins\Cat.DefaultDocumentationPlugin.dll</DefaultDocumentationPlugins>
        <DefaultDocumentationAssemblyPageName>index</DefaultDocumentationAssemblyPageName>
        <DefaultDocumentationUrlFactories>CatMemberParameter|DocItem|DotnetApi</DefaultDocumentationUrlFactories>
    </PropertyGroup>

    <ItemGroup>
        <None Include="..\..\..\resources\icon\CatIcon.png" Pack="true" PackagePath="\"/>
        <None Include="..\..\..\README_NUGET.md" Pack="true" PackagePath="\"/>
    </ItemGroup>
</Project>
